---


import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  quality?: number | "low" | "mid" | "high" | "max";
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  class: className,
  width,
  height,
  loading = "lazy",
  fetchpriority,
  quality,
  widths,
  sizes,
} = Astro.props;

// Grab every image under src/assets (any subfolder, common formats).
const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif}"
);

// Normalize CMS path (leading slash optional)
const key = src.startsWith("/") ? src : `/${src}`;

const loader = images[key];
---

{
  loader ? (
    <Image
      src={loader()}
      alt={alt}
      class={className}
      width={width}
      height={height}
      widths={widths}
      sizes={sizes}
      loading={loading}
      fetchpriority={fetchpriority}
      quality={quality ?? 80}
    />
  ) : (
    // Fallback: plain <img> if not resolved via src/assets
    <img
      src={src}
      alt={alt}
      class={className}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
    />
  )
}
