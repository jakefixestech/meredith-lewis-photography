---
import Layout from "../layouts/Layout.astro";
import content from "../content/404.json";
import SmartImage from "../components/SmartImage.astro";

const hasBgImage = Boolean(content.bg_image);
---

<Layout
  title="Page Not Found | Meredith Lewis Photography"
  description="The page you're looking for couldn't be found. Head back to the Meredith Lewis Photography homepage."
  noindex={true}
>
  <section class="relative flex min-h-[70vh] items-center justify-center overflow-hidden px-5 py-32 sm:px-8">
    {hasBgImage && (
      <>
        <SmartImage
          src={content.bg_image}
          alt={content.bg_image_alt}
          width={1600}
          height={1000}
          loading="eager"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover"
        />
        <div class="absolute inset-0 bg-black/70"></div>
      </>
    )}
    <div class={`relative z-10 mx-auto max-w-xl text-center ${hasBgImage ? "text-white" : ""}`}>
      <p class={`mb-6 text-xs font-medium uppercase tracking-[0.3em] ${hasBgImage ? "text-white/80" : "text-neutral-500"}`}>
        {content.eyebrow}
      </p>
      <h1 class={`font-serif text-6xl font-medium leading-none sm:text-7xl ${hasBgImage ? "text-white" : "text-neutral-900"}`}>
        {content.heading}
      </h1>
      <p class={`mx-auto mt-8 max-w-md text-lg font-light leading-relaxed text-pretty ${hasBgImage ? "text-white/90" : "text-neutral-600"}`}>
        {content.body_text}
      </p>
      <a
        href="/"
        class={`mt-10 inline-block rounded-full px-8 py-3 text-sm font-medium uppercase tracking-[0.15em] transition-colors ${
          hasBgImage
            ? "bg-white text-neutral-900 hover:bg-neutral-200"
            : "bg-neutral-900 text-white hover:bg-neutral-700"
        }`}
      >
        {content.button_label}
      </a>
    </div>
  </section>
</Layout>
