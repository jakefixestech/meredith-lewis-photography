---
import Layout from "../layouts/Layout.astro";
import SmartImage from "../components/SmartImage.astro";

// Safe dynamic lookup to ensure it won't crash if Decap hasn't built the JSON yet
let rawContent: any = {};
try {
  const contentFile = await import("../content/about.json");
  rawContent = contentFile.default || {};
} catch (e) {
  rawContent = {};
}

const titleEyebrow = rawContent.title_eyebrow || "About Your Photographer";
const titleHeading = rawContent.title_heading || "Hi, friend! I'm Meredith!";

const s1Photo = rawContent.section_1_photo || "";
const s1Text = rawContent.section_1_text || "Fueled by maple iced lattes and my faith, I spend my days figuring out how to be a better wife, dog mom, and photographer. If you're the kind of person who loves a little adventure, doesn't take life too seriously, and enjoys a good laugh, I have a feeling we'll get along just great!";

const s2Photo = rawContent.section_2_photo || "";
const s2Text = rawContent.section_2_text || "As a photographer, I always love to try new things and I am not afraid of a bit of adventure. Whether romping your truck through a field, going for a swim in a river, or creating photos that involve camouflage and a tree stand (still waiting for that dream session hint hint) it's an honor that you trust me to tell your story. I am that photographer who is all in on your session!";

const s3Photo = rawContent.section_3_photo || "";
const s3Text = rawContent.section_3_text || "I picked up my first camera shortly after getting married in 2018, and I was hooked almost immediately. I've always loved anything creative, so photography became the perfect way to combine my love for art with my love for people. In 2019, I officially started my photography business on the Southern Maine seacoast where I grew up. Then, in the spring of 2022, my husband and I packed up our life and moved to the Littleton area of Northern New Hampshire, and I've been photographing amazing people here ever since.";

const s4Photo = rawContent.section_4_photo || "";
const s4Text = rawContent.section_4_text || "At the end of the day, my favorite part of this job isn't just creating beautiful images, it's getting to know the amazing people in front of my camera. Every session has a story worth telling and it's an honor that you trust me to capture a small piece of yours. I can't wait to meet you, laugh with you, and create photos you'll treasure for all years to come!";
---

<Layout
  title="About Meredith | Meredith Lewis Photography"
  description="Meet Meredith Lewis, a New Hampshire based photographer rooted in the White Mountains, capturing candid, heartfelt moments."
  solidNav={true}
>
  {/* Hero Title Header */}
  <section class="bg-white px-5 pt-24 pb-12 text-center sm:px-8 sm:pt-32 lg:px-12">
    <div class="mx-auto max-w-3xl">
      <span class="text-xs font-medium uppercase tracking-[0.25em] text-neutral-500">
        {titleEyebrow}
      </span>
      <h1 class="mt-3 font-serif text-4xl font-medium tracking-tight text-neutral-900 sm:text-5xl md:text-6xl">
        {titleHeading}
      </h1>
      <div class="mx-auto mt-8 h-px w-16 bg-neutral-300"></div>
    </div>
  </section>

  {/* Story Segments Layout Grid */}
  <div class="w-full bg-white pb-24">
    <div class="mx-auto max-w-6xl px-5 sm:px-8 lg:px-12 flex flex-col gap-20 md:gap-28">
      
      {/* Block 1: Intro / Latte & Faith */}
      <section class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-5 aspect-[3/4] w-full bg-neutral-50 overflow-hidden rounded-sm shadow-sm">
          {s1Photo && <SmartImage src={s1Photo} alt="Meredith Lewis Photography" width={1200} height={1600} widths={[400, 600, 750, 900, 1200]} sizes="(min-width: 768px) 480px, 100vw" quality={72} loading="eager" fetchpriority="high" class="h-full w-full object-cover" />}
        </div>
        <div class="md:col-span-7 md:pl-6">
          <p class="text-base font-light leading-relaxed text-neutral-700 text-pretty sm:text-lg">
            {s1Text}
          </p>
        </div>
      </section>

      {/* Block 2: Philosophy / Alternating column (Photo on Right) */}
      <section class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-7 order-2 md:order-1 md:pr-6">
          <h2 class="font-serif text-xl font-medium text-neutral-900 mb-4 sm:text-2xl">All In On Your Session</h2>
          <p class="text-base font-light leading-relaxed text-neutral-700 text-pretty">
            {s2Text}
          </p>
        </div>
        <div class="md:col-span-5 order-1 md:order-2 aspect-[3/4] w-full bg-neutral-50 overflow-hidden rounded-sm shadow-sm">
          {s2Photo && <SmartImage src={s2Photo} alt="Meredith Lewis in action" width={1200} height={1600} widths={[400, 600, 750, 900, 1200]} sizes="(min-width: 768px) 480px, 100vw" quality={72} class="h-full w-full object-cover" />}
        </div>
      </section>

      {/* Block 3: History & Journey */}
      <section class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-5 aspect-[3/4] w-full bg-neutral-50 overflow-hidden rounded-sm shadow-sm">
          {s3Photo && <SmartImage src={s3Photo} alt="Meredith's Photography Journey" width={1200} height={1600} widths={[400, 600, 750, 900, 1200]} sizes="(min-width: 768px) 480px, 100vw" quality={72} class="h-full w-full object-cover" />}
        </div>
        <div class="md:col-span-7 md:pl-6">
          <h2 class="font-serif text-xl font-medium text-neutral-900 mb-4 sm:text-2xl">The Journey So Far</h2>
          <p class="text-base font-light leading-relaxed text-neutral-700 text-pretty">
            {s3Text}
          </p>
        </div>
      </section>

      {/* Block 4: Final Mission & Core Connection */}
      <section class="grid grid-cols-1 items-center gap-10 md:grid-cols-12">
        <div class="md:col-span-7 order-2 md:order-1 md:pr-6">
          <h2 class="font-serif text-xl font-medium text-neutral-900 mb-4 sm:text-2xl">Stories Worth Telling</h2>
          <p class="text-base font-light leading-relaxed text-neutral-700 text-pretty">
            {s4Text}
          </p>
          <p class="mt-8 font-serif text-lg italic text-neutral-800">
            Let’s chase the golden hour light together!
          </p>
          <div class="mt-8">
            <a
              href="/contact"
              class="inline-block rounded-full bg-neutral-950 px-8 py-3 text-sm font-medium uppercase tracking-[0.15em] text-white transition-colors hover:bg-neutral-800 shadow-sm"
            >
              Get In Touch
            </a>
          </div>
        </div>
        <div class="md:col-span-5 order-1 md:order-2 aspect-[3/4] w-full bg-neutral-50 overflow-hidden rounded-sm shadow-sm">
          {s4Photo && <SmartImage src={s4Photo} alt="Meredith Lewis" width={1200} height={1600} widths={[400, 600, 750, 900, 1200]} sizes="(min-width: 768px) 480px, 100vw" quality={72} class="h-full w-full object-cover" />}
        </div>
      </section>

    </div>
  </div>
</Layout>