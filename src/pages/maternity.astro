---
import Layout from "../layouts/Layout.astro";
import SmartImage from "../components/SmartImage.astro";
import content from "../content/portfolio-maternity.json";

interface SessionItem {
  set_title?: string;
  images: Array<string | { img_src: string }>;
}

const rawContent = content as any;

const headerEyebrow = rawContent.header_eyebrow || "Galleries";
const headerHeading = rawContent.header_heading || "Maternity";
const headerIntro = rawContent.header_intro || "";
const ctaText = rawContent.cta_text || "";
const storySets = (rawContent.story_sets as SessionItem[]) || [];
---

<Layout
  title={`${headerHeading} Portfolio | Meredith Lewis Photography`}
  description={headerIntro || "Natural, elegant maternity photography sessions in Dalton, Littleton, and across the White Mountains, NH."}
  solidNav={true}
>
  <style is:global>
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>

  <section class="bg-white px-5 py-20 text-center sm:px-8 sm:py-24 lg:px-12">
    <div class="mx-auto max-w-3xl">
      <span class="text-xs font-medium uppercase tracking-[0.2em] text-neutral-500">
        {headerEyebrow}
      </span>
      <h1 class="mt-3 font-serif text-4xl font-medium tracking-tight text-neutral-900 sm:text-5xl">
        {headerHeading}
      </h1>
      <div class="mx-auto mt-6 h-px w-16 bg-neutral-300"></div>
      <p class="mt-6 text-base font-light leading-relaxed text-neutral-600 text-pretty">
        {headerIntro}
      </p>
    </div>
  </section>

  {/* Slider Sessions Grid System */}
  {storySets.map((set, rowIndex) => {
    const isEvenRow = rowIndex % 2 === 0;
    
    return (
      <section class={`session-container w-full py-16 px-5 sm:px-8 lg:px-12 border-t border-neutral-100 ${isEvenRow ? 'bg-stone-50/40' : 'bg-white'}`}>
        <div class="mx-auto max-w-7xl">
          
          <div class="mb-8 border-b pb-3 border-neutral-200 max-w-xs">
            <h2 class="text-sm font-sans font-semibold uppercase tracking-[0.15em] text-neutral-800 sm:text-base">
              {set.set_title || `Featured Session — ${rowIndex + 1}`}
            </h2>
          </div>

          <div class="group/slider relative w-full px-0 md:px-4">
            
            <button 
              class="slider-arrow-prev absolute left-0 top-1/2 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full border border-neutral-200 bg-white/90 p-3 text-neutral-700 shadow-sm transition-all duration-200 hover:bg-neutral-900 hover:text-white md:flex opacity-0 group-hover/slider:opacity-100 backdrop-blur-sm"
              aria-label="Scroll left"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" />
              </svg>
            </button>

            <div class="slider-track no-scrollbar flex gap-6 overflow-x-auto pb-2 snap-x snap-mandatory scroll-smooth items-stretch">
              {set.images?.map((imgObj, imgIndex) => {
                if (!imgObj) return null;

                const finalSrc = typeof imgObj === 'string' ? imgObj : imgObj.img_src;
                if (!finalSrc) return null;

                return (
                  <div class="flex-none w-[82vw] sm:w-[45vw] md:w-[31vw] lg:w-[23.5vw] snap-start">
                    <div 
                      class="portfolio-item h-full overflow-hidden rounded-sm group cursor-pointer bg-neutral-100 dark:bg-neutral-900 shadow-sm transition-all duration-300 hover:shadow-md"
                      data-image-alt={`${set.set_title || 'Featured Session'} — ${imgIndex + 1}`}
                      data-index={imgIndex}
                    >
                      <div class="overflow-hidden bg-neutral-100 dark:bg-neutral-900 aspect-[2/3] w-full h-full flex items-center">
                        <SmartImage
                          src={finalSrc}
                          alt={`${set.set_title || 'Featured Session'} — ${imgIndex + 1}`}
                          width={1200}
                          height={1800}
                          widths={[500, 750, 1000, 1200]}
                          sizes="(min-width: 1024px) 23.5vw, (min-width: 768px) 31vw, (min-width: 640px) 45vw, 82vw"
                          loading={rowIndex === 0 && imgIndex === 0 ? "eager" : "lazy"}
                          fetchpriority={rowIndex === 0 && imgIndex === 0 ? "high" : "auto"}
                          class="portfolio-img h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.015]"
                        />
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
            
            <button 
              class="slider-arrow-next absolute right-0 top-1/2 z-10 hidden -translate-y-1/2 items-center justify-center rounded-full border border-neutral-200 bg-white/90 p-3 text-neutral-700 shadow-sm transition-all duration-200 hover:bg-neutral-900 hover:text-white md:flex opacity-0 group-hover/slider:opacity-100 backdrop-blur-sm"
              aria-label="Scroll right"
            >
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="h-5 w-5">
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
              </svg>
            </button>
            
            <div class="pointer-events-none mt-2 flex justify-end text-[10px] uppercase tracking-widest text-neutral-400 sm:hidden">
              Swipe to explore ➔
            </div>
          </div>

        </div>
      </section>
    );
  })}

  {/* Solid Black Callout Background Section */}
  <section class="bg-neutral-950 px-5 py-24 text-center text-white sm:px-8 lg:px-12">
    <div class="mx-auto max-w-2xl">
      <h2 class="font-serif text-3xl font-medium tracking-tight sm:text-4xl">
        {ctaText}
      </h2>
      <div class="mt-10">
        <a 
          href="/contact" 
          class="inline-block rounded-full bg-white px-8 py-3 text-sm font-medium uppercase tracking-[0.15em] text-neutral-950 transition-colors hover:bg-neutral-200 shadow-sm"
        >
          Let's Chat
        </a>
      </div>
    </div>
  </section>

  {/* Lightbox Module */}
  <div
    id="lightbox"
    class="fixed inset-0 z-[100] hidden flex-col items-center justify-center bg-black/95 p-4 opacity-0 transition-opacity duration-300 backdrop-blur-sm select-none"
    role="dialog"
    aria-label="Image viewer"
    aria-hidden="true"
  >
    <button id="lightbox-close" aria-label="Close image viewer" class="absolute top-6 right-6 z-[110] text-white/70 hover:text-white p-2"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" /></svg></button>
    <div class="relative flex h-full w-full max-w-6xl items-center justify-center px-12">
      <button id="lightbox-prev" aria-label="Previous image" class="absolute left-4 z-[110] hidden sm:flex text-white/50 hover:text-white p-4 rounded-full hover:bg-white/5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5" /></svg></button>
      <div class="relative max-h-[85vh] max-w-[90vw] flex items-center justify-center">
        <img id="lightbox-img" src="" alt="" class="max-h-[85vh] max-w-[90vw] object-contain rounded-sm shadow-2xl pointer-events-none" />
      </div>
      <button id="lightbox-next" aria-label="Next image" class="absolute right-4 z-[110] hidden sm:flex text-white/50 hover:text-white p-4 rounded-full hover:bg-white/5"><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-8 w-8"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" /></svg></button>
    </div>
  </div>
</Layout>

<script>
  function initGalleryControls() {
    const arrowContainers = document.querySelectorAll('.group\\/slider');
    arrowContainers.forEach(container => {
      const track = container.querySelector('.slider-track');
      const prevBtn = container.querySelector('.slider-arrow-prev');
      const nextBtn = container.querySelector('.slider-arrow-next');
      if (!track || !prevBtn || !nextBtn) return;

      const getScrollAmount = () => {
        const firstItem = track.querySelector('.flex-none');
        return firstItem ? firstItem.clientWidth + 24 : track.clientWidth * 0.75;
      };
      nextBtn.addEventListener('click', () => { track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' }); });
      prevBtn.addEventListener('click', () => { track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' }); });
    });

    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement;
    const closeBtn = document.getElementById('lightbox-close');
    const lightPrevBtn = document.getElementById('lightbox-prev');
    const lightNextBtn = document.getElementById('lightbox-next');
    if (!lightbox || !lightboxImg) return;

    let activeItems: HTMLElement[] = [];
    let currentIndex = 0;
    let touchStartX = 0;
    let touchEndX = 0;

    const openLightbox = (itemsInSession: HTMLElement[], index: number) => {
      activeItems = itemsInSession;
      currentIndex = index;
      updateLightboxContent();
      lightbox.classList.remove('hidden');
      lightbox.classList.add('flex');
      setTimeout(() => { lightbox.classList.remove('opacity-0'); lightbox.classList.add('opacity-100'); }, 10);
      document.body.style.overflow = 'hidden';
    };

    const closeLightbox = () => {
      lightbox.classList.remove('opacity-100');
      lightbox.classList.add('opacity-0');
      setTimeout(() => { lightbox.classList.remove('flex'); lightbox.classList.add('hidden'); }, 300);
      document.body.style.overflow = '';
    };

    const showNext = () => { if (activeItems.length === 0) return; currentIndex = (currentIndex + 1) % activeItems.length; updateLightboxContent(); };
    const showPrev = () => { if (activeItems.length === 0) return; currentIndex = (currentIndex - 1 + activeItems.length) % activeItems.length; updateLightboxContent(); };

    const updateLightboxContent = () => {
      const wrapper = activeItems[currentIndex];
      if (wrapper) {
        const realImg = wrapper.querySelector('img') as HTMLImageElement;
        if (realImg) {
          lightboxImg.src = realImg.src;
          lightboxImg.alt = wrapper.getAttribute('data-image-alt') || '';
        }
      }
    };

    lightbox.addEventListener('touchstart', (e: TouchEvent) => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
    lightbox.addEventListener('touchend', (e: TouchEvent) => { touchEndX = e.changedTouches[0].screenX; const dist = touchEndX - touchStartX; if (dist < -50) showNext(); if (dist > 50) showPrev(); }, { passive: true });

    const sessions = document.querySelectorAll('.session-container');
    sessions.forEach(session => {
      const items = Array.from(session.querySelectorAll('.portfolio-item')).sort((a, b) => {
        return parseInt(a.getAttribute('data-index') || '0', 10) - parseInt(b.getAttribute('data-index') || '0', 10);
      }) as HTMLElement[];

      items.forEach((item, index) => {
        const newItem = item.cloneNode(true);
        item.parentNode?.replaceChild(newItem, item);
        newItem.addEventListener('click', () => openLightbox(items, index));
      });
    });

    closeBtn?.addEventListener('click', closeLightbox);
    lightNextBtn?.addEventListener('click', showNext);
    lightPrevBtn?.addEventListener('click', showPrev);
    lightbox.addEventListener('click', (e) => { if (e.target === lightbox) closeLightbox(); });

    const handleKeyDown = (e: KeyboardEvent) => {
      if (lightbox.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowRight') showNext();
      if (e.key === 'ArrowLeft') showPrev();
    };
    document.removeEventListener('keydown', handleKeyDown);
    document.addEventListener('keydown', handleKeyDown);
  }

  initGalleryControls();
  document.addEventListener('astro:page-load', initGalleryControls);
</script>